{
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "src": "/master(\\.html)?$", "status": 302, "headers": { "Location": "/security_error" } },
    { "src": "/ogrenci(\\.html)?$", "status": 302, "headers": { "Location": "/security_error" } },
    { "src": "/ogretmen(\\.html)?$", "status": 302, "headers": { "Location": "/security_error" } },
    { "src": "/dashboard(\\.html)?$", "status": 302, "headers": { "Location": "/security_error" } },
    { "src": "/k9x7v2m4(\\.html)?$", "dest": "/index.html" },
    { "src": "/h6t3y9w1(\\.html)?$", "dest": "/ogretmen.html" },
    { "src": "/r1p5s8q3(\\.html)?$", "dest": "/dashboard.html" },
    { "src": "/n4b9v1c7(\\.html)?$", "dest": "/master.html" },
    { "src": "/j2k5l0p8(\\.html)?$", "dest": "/ogrenci.html" },
    { "src": "/km2x9v3a(\\.html)?$", "dest": "/km_ogretmen.html" },
    { "src": "/km8b4w1e(\\.html)?$", "dest": "/km_admin.html" },
    { "src": "/km5c7r6s(\\.html)?$", "dest": "/km_ogrenci.html" },
    { "src": "/yoklama_ogretmen(\\.html)?$", "dest": "/yoklama_ogretmen.html" },
    { "src": "/yoklama_idareci(\\.html)?$", "dest": "/yoklama_idareci.html" },
    { "src": "/zumreci(\\.html)?$", "dest": "/zumreci.html" },
    { "src": "/security_error(\\.html)?$", "dest": "/404.html" },
    { "handle": "filesystem" },
    { "src": "^/([^./]+)$", "dest": "/$1.html" }
  ]
}