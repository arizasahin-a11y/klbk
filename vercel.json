{
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/master(\\.html)?$",
      "status": 302,
      "headers": {
        "Location": "/security_error"
      }
    },
    {
      "src": "/ogrenci(\\.html)?$",
      "status": 302,
      "headers": {
        "Location": "/security_error"
      }
    },
    {
      "src": "/ogretmen(\\.html)?$",
      "status": 302,
      "headers": {
        "Location": "/security_error"
      }
    },
    {
      "src": "/dashboard(\\.html)?$",
      "status": 302,
      "headers": {
        "Location": "/security_error"
      }
    },
    {
      "src": "/k9x7v2m4(\\.html)?$",
      "dest": "/index.html"
    },
    {
      "src": "/h6t3y9w1(\\.html)?$",
      "dest": "/ogretmen.html"
    },
